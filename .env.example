# Copy to .env and fill in. Never commit .env, and never paste your key into a chat.

# Free key: create one in Google AI Studio (aistudio.google.com) with "Get API key".
GEMINI_API_KEY=your-key-here

# Model for most calls. Flash-Lite models tend to have the most generous free-tier limits.
# Check your real limits in AI Studio and change this if you have headroom.
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: a stronger model just for extraction, the one call per document that matters most.
# GEMINI_EXTRACT_MODEL=gemini-3.8-flash

# Cache identical AI requests on disk so re-runs and the demo don't spend quota. 0 = off.
LLM_CACHE=1
# Set to "none" to run with the AI switched off (the demo's "AI is down" mode).
LLM_PROVIDER=gemini

# hash = no download, matches shared words (fine for the 7 sample documents).
# auto = use the local MiniLM model if sentence-transformers is installed.
EMBEDDER=hash

# The date "overdue" is judged against. The sample story is written as of Oct 17, 2026.
# Remove this line to use today's real date.
HANDOFF_AS_OF=2026-10-17
